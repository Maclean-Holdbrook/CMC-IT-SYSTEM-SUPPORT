# Frontend Environment Variables

# Backend API URL
# For local development: http://localhost:5000/api/v1
# For production (Vercel): https://your-backend-app.vercel.app/api/v1
VITE_API_URL=http://localhost:5000/api/v1

# Supabase browser configuration (safe to expose; access is enforced by RLS)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Never add SUPABASE_SERVICE_ROLE_KEY or RESEND_API_KEY to this frontend file.
